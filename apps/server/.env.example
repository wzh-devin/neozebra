HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://neozebra:replace-with-your-password@127.0.0.1:5432/neozebra
REDIS_URL=redis://:replace-with-your-password@127.0.0.1:6379
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MAIL_ENCRYPTION_KEY=replace-with-64-hex-characters

BAIDU_DRIVE_CLIENT_ID=
BAIDU_DRIVE_CLIENT_SECRET=
ALIYUN_DRIVE_CLIENT_ID=
ALIYUN_DRIVE_CLIENT_SECRET=

# API and Worker share this persistent directory; no fixed per-file size limit.
DRIVE_UPLOAD_DIRECTORY=.data/drive-uploads

# Self-hosted ONLYOFFICE Docs (docker compose -f deploy/office/compose.yaml up -d)
# Browser-reachable address; use an HTTPS reverse proxy in production.
OFFICE_PUBLIC_URL=http://localhost:8088
# API origin reachable from Document Server, not the browser's localhost.
OFFICE_SOURCE_ORIGIN=http://host.docker.internal:3000
# Must match deploy/office/.env; generate with openssl rand -hex 32.
OFFICE_JWT_SECRET=
# Persistent shared volume required for API and Drive worker.
DRIVE_PREVIEW_DIRECTORY=.data/drive-previews
