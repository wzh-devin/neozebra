{
  "name": "@neozebra/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --conditions=development --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "oxlint src checks",
    "test": "node --conditions=development --test checks/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --conditions=development src/infrastructure/database/migrate.ts",
    "test:integration": "node --env-file=.env --conditions=development --test checks/inbox.integration.test.ts",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@neozebra/assets": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "imapflow": "^2.3.0",
    "mailparser": "^3.9.37",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.2"
  }
}
