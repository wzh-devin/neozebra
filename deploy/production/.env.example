APP_IMAGE=ghcr.io/wzh-devin/neozebra
# Exact version Git tag, e.g. v1.0.0. Required; no implicit latest tag.
IMAGE_TAG=
# Host port behind your existing HTTPS / authentication reverse proxy.
WEB_PORT=8080
APP_ORIGIN=https://workspace.example.com

# Existing services must be reachable from Docker, not host loopback addresses.
DATABASE_URL=postgresql://neozebra:replace-me@postgres.example.com:5432/neozebra?sslmode=require
REDIS_URL=rediss://:replace-me@redis.example.com:6379/0
# Preserve the existing key when deploying an existing database. For a new instance:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MAIL_ENCRYPTION_KEY=

# Optional overrides; blank means use DATABASE_URL / REDIS_URL above.
STORAGE_DATABASE_URL=
STORAGE_REDIS_URL=
STORAGE_SCHEMA=neozebra_storage
STORAGE_MINIO_ENDPOINT=https://minio.example.com
# Browser uploads go directly here; preserve the signed Host and path.
STORAGE_MINIO_PUBLIC_ENDPOINT=https://minio.example.com
STORAGE_MINIO_ACCESS_KEY=
STORAGE_MINIO_SECRET_KEY=
STORAGE_MINIO_BUCKET=neozebra-private
STORAGE_MINIO_REGION=us-east-1
