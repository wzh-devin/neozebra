# 新文件库专用配置。复制为 .env，填入新服务；不读取旧 Drive 连接。
STORAGE_DATABASE_URL=postgresql://neozebra:development-only@127.0.0.1:15432/neozebra?sslmode=disable
STORAGE_SCHEMA=neozebra_storage
STORAGE_REDIS_URL=redis://127.0.0.1:16379/0
APP_ORIGIN=http://localhost:5174
STORAGE_ADDRESS=127.0.0.1:3001
STORAGE_MINIO_ENDPOINT=http://127.0.0.1:19000
# 浏览器可访问的原始 MinIO 地址，不能经过改变 Host/路径的代理。
STORAGE_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:19000
STORAGE_MINIO_ACCESS_KEY=
STORAGE_MINIO_SECRET_KEY=
STORAGE_MINIO_BUCKET=neozebra-private
STORAGE_MINIO_REGION=us-east-1
# 可选私有预览服务；使用 deploy/preview/compose.yaml，无额外密码或签名密钥。
STORAGE_PREVIEW_URL=http://127.0.0.1:8012
# 预览容器访问 Go 的地址。Linux 需确保该地址可达，不能公开暴露存储 API。
STORAGE_PREVIEW_SOURCE_ORIGIN=http://host.docker.internal:3001
